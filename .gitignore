.DS_Store

# Python. The host re-runs `uv sync` and `pytest` against every agent branch;
# left untracked, what they produce makes the tree dirty — which the
# orchestrator refuses to run on.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Local env — never commit. `.env` is host-only: unlike .sandcastle/.env it is
# never forwarded into the sandbox, so host credentials belong there.
.env
.sandcastle/.env

# Sandcastle's own Node dependencies and working state
.sandcastle/node_modules/
.sandcastle/worktrees/
.sandcastle/logs/
.sandcastle/patches/

# Vercel
.vercel

# Claude Code worktrees. Untracked, and the orchestrator refuses to start on a
# dirty tree — so without this an open worktree blocks the whole pipeline.
.claude/worktrees/
