{
  "name": "fast-questionnaire-sandcastle",
  "private": true,
  "description": "The Sandcastle harness that implements this repository's issues. Not part of the application, which is Python.",
  "type": "module",
  "scripts": {
    "sandcastle": "cd .. && tsx --env-file-if-exists=.env --env-file-if-exists=.sandcastle/.env .sandcastle/main.mts",
    "check": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.mts"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "0.12.0",
    "@types/node": "^26.4.1",
    "@vercel/sandbox": "~1.10.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  }
}
